<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.brunojaegerk</groupId>
  <artifactId>KingOfTheHillNK</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>KingOfTheHillNK</name>
  <description>Eventos King of the Hill para NukkitPetteriM1Edition</description>
  <url>https://github.com/BrunoJaegerK/KothNK</url>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
  </properties>
  <repositories>
    <repository>
      <id>opencollab-snapshots</id>
      <url>https://repo.opencollab.dev/maven-snapshots/</url>
      <releases><enabled>false</enabled></releases>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
    <repository>
      <id>opencollab-releases</id>
      <url>https://repo.opencollab.dev/maven-releases/</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>
  <profiles>
    <!-- API Nukkit publicada en OpenCollab para CI; usar libs/server.jar para validar PM1E exacto. -->
    <profile>
      <id>nukkit-api</id>
      <activation><activeByDefault>true</activeByDefault></activation>
      <dependencies>
        <dependency>
          <groupId>cn.nukkit</groupId>
          <artifactId>nukkit</artifactId>
          <version>1.0-SNAPSHOT</version>
          <scope>provided</scope>
        </dependency>
      </dependencies>
    </profile>
    <!-- Si se coloca el JAR exacto del servidor en libs/server.jar, Maven
         activa este perfil y compila directamente contra esa distribución PM1E. -->
    <profile>
      <id>pm1e-local</id>
      <activation><file><exists>${project.basedir}/libs/server.jar</exists></file></activation>
      <dependencies>
        <dependency>
          <groupId>cn.nukkit</groupId>
          <artifactId>Nukkit-PM1E-local</artifactId>
          <version>local</version>
          <scope>system</scope>
          <systemPath>${project.basedir}/libs/server.jar</systemPath>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
  <build>
    <finalName>KingOfTheHillNK-${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>enforce-java-and-maven</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion><version>[17,)</version></requireJavaVersion>
                <requireMavenVersion><version>[3.8.6,)</version></requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration><release>17</release><encoding>UTF-8</encoding></configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
      </plugin>
    </plugins>
  </build>
</project>
